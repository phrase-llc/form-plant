name = "form-plant"
compatibility_date = "2024-05-11"

pages_build_output_dir = "./public"

[vars]
AWS_REGION = "ap-northeast-1"
AWS_ACCESS_KEY_ID="******"
AWS_SECRET_ACCESS_KEY="******"
SES_FROM_ADDRESS="from@example.com"
SES_TO_ADDRESS="to@example.com"
TURNSTILE_SECRET_KEY="0x*******"
ALLOWED_ORIGINS="http://localhost:8788"
# 任意。メールの件名に付ける表示名。未設定なら件名は「【FormPlant】お問い合わせ」だけになる。
MAIL_SUBJECT_LABEL="example.com"
